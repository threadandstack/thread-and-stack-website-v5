# Names only. Real values are set in the Lovable project's environment
# settings (and Supabase edge function secrets for server-side values).
# Copy to .env for local dev and fill in.

# Supabase (publishable/anon key, not service_role)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Payments publishable client token: pk_test… in .env.development,
# pk_live… in .env.production
VITE_PAYMENTS_CLIENT_TOKEN=
